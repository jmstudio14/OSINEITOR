{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jmstudio14/OSINEITOR/docs/cli-contract.schema.json",
  "title": "Contrato CLI↔GUI de OSINEITOR (versión 1)",
  "description": "Eventos NDJSON (--ndjson) y salidas JSON (--json). Los cambios futuros son solo aditivos: ignora lo que no conozcas.",
  "$defs": {
    "entity": {
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "data": {
          "type": "object"
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "module",
              "query"
            ],
            "properties": {
              "module": {
                "type": "string"
              },
              "query": {
                "type": "string"
              },
              "at": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "first_seen": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_seen": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "enum": [
            "bajo",
            "medio",
            "alto",
            null
          ]
        }
      },
      "additionalProperties": true
    },
    "module_run": {
      "type": "object",
      "required": [
        "module",
        "status"
      ],
      "properties": {
        "module": {
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "empty",
            "error",
            "skipped",
            "quota"
          ]
        },
        "entity": {
          "type": [
            "string",
            "null"
          ]
        },
        "entities": {
          "type": "integer"
        },
        "requests": {
          "type": "integer"
        },
        "cache_hits": {
          "type": "integer"
        },
        "duration_ms": {
          "type": "integer"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "scan_event": {
      "type": "object",
      "required": [
        "kind",
        "module",
        "message"
      ],
      "properties": {
        "kind": {
          "enum": [
            "error",
            "skipped",
            "budget",
            "cancelled"
          ]
        },
        "module": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "entity": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "scan_result": {
      "type": "object",
      "required": [
        "target",
        "depth",
        "started_at",
        "entities",
        "events",
        "runs",
        "truncated",
        "status"
      ],
      "properties": {
        "target": {
          "$ref": "#/$defs/entity"
        },
        "depth": {
          "type": "integer"
        },
        "started_at": {
          "type": "string"
        },
        "finished_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "entities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entity"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scan_event"
          }
        },
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/module_run"
          }
        },
        "scan_id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "truncated": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "complete",
            "truncated",
            "cancelled"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "evidence_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "purpose": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "scope": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "domains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ips": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "event_scan_start": {
      "type": "object",
      "required": [
        "v",
        "ts",
        "type",
        "target",
        "depth",
        "modules",
        "skipped",
        "budget"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "ts": {
          "type": "string"
        },
        "type": {
          "const": "scan.start"
        },
        "target": {
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "depth": {
          "type": "integer"
        },
        "modules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skipped": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "module",
              "message"
            ],
            "properties": {
              "module": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "purpose": {
          "type": [
            "string",
            "null"
          ]
        },
        "budget": {
          "type": "object",
          "required": [],
          "properties": {
            "max_entities": {
              "type": [
                "integer",
                "null"
              ]
            },
            "max_requests": {
              "type": [
                "integer",
                "null"
              ]
            },
            "max_seconds": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "event_module_start": {
      "type": "object",
      "required": [
        "v",
        "ts",
        "type",
        "module",
        "entity"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "ts": {
          "type": "string"
        },
        "type": {
          "const": "module.start"
        },
        "module": {
          "type": "string"
        },
        "entity": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "event_module_end": {
      "type": "object",
      "required": [
        "v",
        "ts",
        "type",
        "module",
        "status",
        "entity",
        "entities",
        "requests",
        "cache_hits",
        "duration_ms",
        "message"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "ts": {
          "type": "string"
        },
        "type": {
          "const": "module.end"
        },
        "module": {
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "empty",
            "error",
            "skipped",
            "quota"
          ]
        },
        "entity": {
          "type": "string"
        },
        "entities": {
          "type": "integer"
        },
        "requests": {
          "type": "integer"
        },
        "cache_hits": {
          "type": "integer"
        },
        "duration_ms": {
          "type": "integer"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "event_entity": {
      "type": "object",
      "required": [
        "v",
        "ts",
        "type",
        "entity"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "ts": {
          "type": "string"
        },
        "type": {
          "const": "entity"
        },
        "entity": {
          "$ref": "#/$defs/entity"
        }
      },
      "additionalProperties": true
    },
    "event_progress": {
      "type": "object",
      "required": [
        "v",
        "ts",
        "type",
        "done",
        "total",
        "entities",
        "requests"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "ts": {
          "type": "string"
        },
        "type": {
          "const": "progress"
        },
        "done": {
          "type": "integer"
        },
        "total": {
          "type": "integer"
        },
        "entities": {
          "type": "integer"
        },
        "requests": {
          "type": "integer"
        }
      },
      "additionalProperties": true
    },
    "event_notice": {
      "type": "object",
      "required": [
        "v",
        "ts",
        "type",
        "code",
        "message"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "ts": {
          "type": "string"
        },
        "type": {
          "const": "notice"
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "event_scan_end": {
      "type": "object",
      "required": [
        "v",
        "ts",
        "type",
        "status",
        "scan_id",
        "exit_code"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "ts": {
          "type": "string"
        },
        "type": {
          "const": "scan.end"
        },
        "status": {
          "enum": [
            "complete",
            "truncated",
            "cancelled",
            "failed"
          ]
        },
        "scan_id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "exit_code": {
          "type": "integer"
        },
        "entities": {
          "type": "integer"
        },
        "finished_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        },
        "evidence_digest": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "event": {
      "oneOf": [
        {
          "$ref": "#/$defs/event_scan_start"
        },
        {
          "$ref": "#/$defs/event_module_start"
        },
        {
          "$ref": "#/$defs/event_module_end"
        },
        {
          "$ref": "#/$defs/event_entity"
        },
        {
          "$ref": "#/$defs/event_progress"
        },
        {
          "$ref": "#/$defs/event_notice"
        },
        {
          "$ref": "#/$defs/event_scan_end"
        }
      ]
    },
    "modules_output": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "description",
          "consumes",
          "produces",
          "passive",
          "requires_key",
          "key_configured",
          "timeout"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "consumes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "produces": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "passive": {
            "type": "boolean"
          },
          "requires_key": {
            "type": [
              "string",
              "null"
            ]
          },
          "key_configured": {
            "type": "boolean"
          },
          "timeout": {
            "type": "number"
          },
          "analyzer": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    },
    "history_output": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "target_type",
          "target",
          "entities",
          "started_at"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "target_type": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "entities": {
            "type": "integer"
          },
          "started_at": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "doctor_output": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "module",
          "verdict",
          "detail",
          "duration_ms",
          "requests"
        ],
        "properties": {
          "module": {
            "type": "string"
          },
          "verdict": {
            "enum": [
              "ok",
              "empty",
              "fail",
              "skipped",
              "unchecked"
            ]
          },
          "detail": {
            "type": "string"
          },
          "duration_ms": {
            "type": "integer"
          },
          "requests": {
            "type": "integer"
          }
        },
        "additionalProperties": true
      }
    },
    "presets_output": {
      "type": "object",
      "required": [
        "presets",
        "errors"
      ],
      "properties": {
        "presets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "source",
              "description",
              "depth",
              "modules",
              "allow_active",
              "max_entities",
              "max_requests",
              "max_time"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "depth": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "modules": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string"
                }
              },
              "allow_active": {
                "type": "boolean"
              },
              "max_entities": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "max_requests": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "max_time": {
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "additionalProperties": true
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "update_data_output": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "status",
          "detail",
          "license",
          "version",
          "sha256"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "actualizado",
              "sin cambios",
              "rechazado",
              "error"
            ]
          },
          "detail": {
            "type": "string"
          },
          "license": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "config_show_output": {
      "type": "object",
      "required": [
        "path",
        "keys"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "keys": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "version_output": {
      "type": "object",
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "export_output": {
      "type": "object",
      "required": [
        "scan_id",
        "format",
        "path"
      ],
      "properties": {
        "scan_id": {
          "type": "integer"
        },
        "format": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "config_key_output": {
      "type": "object",
      "required": [
        "name",
        "configured"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "configured": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "required": [
        "module",
        "kind",
        "url",
        "method",
        "at",
        "sha256",
        "size",
        "truncated"
      ],
      "properties": {
        "module": {
          "type": "string"
        },
        "entity": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "enum": [
            "http",
            "dns"
          ]
        },
        "url": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "status": {
          "type": [
            "integer",
            "null"
          ]
        },
        "at": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "verify_output": {
      "type": "object",
      "required": [
        "scan_id",
        "checked",
        "ok",
        "mismatches",
        "evidence_digest",
        "digest_match"
      ],
      "properties": {
        "scan_id": {
          "type": "integer"
        },
        "checked": {
          "type": "integer"
        },
        "ok": {
          "type": "boolean"
        },
        "mismatches": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "number",
              "module",
              "url",
              "expected",
              "actual"
            ],
            "properties": {
              "number": {
                "type": "integer"
              },
              "module": {
                "type": "string"
              },
              "entity": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "url": {
                "type": "string"
              },
              "expected": {
                "type": "string"
              },
              "actual": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "evidence_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "digest_match": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": true
    }
  }
}
